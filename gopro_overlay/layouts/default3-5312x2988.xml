<layout>

  <composite x="2020" y="2520" name="bottom_center_dashboard_safe">

    <!-- Speed card -->
    <frame
        x="0"
        y="0"
        width="1280"
        height="165"
        outline="40,120,255,170"
        cr="20"
        opacity="0.4">

      <component type="text" x="150" y="18" size="30">MPH</component>
      <component type="text" x="770" y="18" size="30">KPH</component>

      <component
          type="metric"
          x="115"
          y="55"
          metric="speed"
          units="mph"
          dp="0"
          size="108"/>

      <component
          type="metric"
          x="735"
          y="55"
          metric="speed"
          units="kph"
          dp="0"
          size="108"/>
    </frame>

    <!-- Power -->
    <frame
        x="0"
        y="200"
        width="300"
        height="175"
        outline="40,120,255,145"
        cr="16"
        opacity="0.4">

      <component type="text" x="20" y="16" size="23">POWER</component>

      <component
          type="metric"
          x="20"
          y="45"
          metric="power"
          dp="0"
          size="66"/>

      <composite x="20" y="118">
        <component
            type="bar"
            metric="power"
            width="240"
            height="22"
            min="0"
            max="1000"
            fill="0,0,0,0"
            outline="70,120,200,160"
            bar="40,120,255,220"/>
      </composite>
    </frame>

    <!-- Gradient -->
    <frame
        x="327"
        y="200"
        width="300"
        height="138"
        outline="40,120,255,145"
        cr="16"
        opacity="0.4">

      <component type="text" x="20" y="16" size="23">SLOPE %</component>

      <component
          type="metric"
          x="20"
          y="48"
          metric="gradient"
          dp="1"
          size="66"/>
    </frame>

    <!-- Cadence -->
    <frame
        x="654"
        y="200"
        width="300"
        height="138"
        outline="40,120,255,145"
        cr="16"
        opacity="0.4">

      <component type="text" x="20" y="16" size="23">CADENCE</component>

      <component
          type="metric"
          x="20"
          y="48"
          metric="cadence"
          dp="0"
          size="66"/>
    </frame>

    <!-- Heart rate -->
    <frame
        x="981"
        y="200"
        width="300"
        height="175"
        outline="40,120,255,145"
        cr="16"
        opacity="0.4">

      <component type="text" x="20" y="16" size="23">HR</component>

      <component
          type="metric"
          x="20"
          y="45"
          metric="hr"
          dp="0"
          size="66"/>

      <composite x="20" y="118">
        <component
            type="bar"
            metric="hr"
            width="240"
            height="22"
            min="60"
            max="200"
            fill="0,0,0,0"
            outline="200,80,80,160"
            bar="255,90,90,220"/>
      </composite>
    </frame>

  </composite>

</layout>